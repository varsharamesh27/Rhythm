{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rhythm: Start local app",
      "type": "process",
      "command": "${workspaceFolder}\\.tools\\node\\node.exe",
      "args": [
        "${workspaceFolder}\\node_modules\\next\\dist\\bin\\next",
        "dev",
        "-H",
        "localhost",
        "-p",
        "3000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": true,
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
