{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "rhythm-personal-tracker",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat_v2"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  }
}
